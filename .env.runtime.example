# Fill every empty secret before starting; the server refuses "replace-with" placeholders.
# Generate each with: openssl rand -hex 32
KY_SESSION_SECRET=
KY_APP_URL=https://kydrive.example.test
KYDRIVE_IDENTITY_URL=https://kyidentity.example.test
KY_SSO_ENABLED=true
KY_SSO_AUTO_PROVISION=false
KY_KYSIGNON_ISSUER=https://identity.example.test
KY_KYSIGNON_CLIENT_ID=kydrive
# Client secret issued by KyIdentity for this client.
KY_KYSIGNON_SECRET=
KY_SCIM_ENABLED=true
# openssl rand -hex 32; the same value goes into KyIdentity's SCIM connector.
KY_SCIM_TOKEN=
KYDRIVE_EDITOR_URL=https://euro-office.example.test
# openssl rand -hex 32; the same JWT secret goes into Euro-Office.
KYDRIVE_EDITOR_SECRET=
KY_BACKUP_DEPOSIT_INTERVAL=24h
KY_BACKUP_KEEP=7
# KY_BACKUP_COLLECT_TIMEOUT=2h
# KY_DRILL_DIR=/app/data/drill
# KY_DRILL_TIMEOUT=2h
# Initial bootstrap only (openssl rand -hex 24); replace on first login and remove from this file.
# Left empty, a generated password is written to <data>/initial-admin-password.
KY_ADMIN_PASSWORD=
