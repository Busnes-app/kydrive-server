# Compose interpolation only. Put credentials in mode-0600 .env.runtime.
# This release's published image; set the version you install. docker-compose.build.yml
# replaces it with the local source build kydrive-server:local.
KY_IMAGE=ghcr.io/busnes-app/kydrive-server:0.4.2
KY_UID=1000
KY_GID=1000
KY_BIND_IP=127.0.0.1
KY_HTTP_PORT=8080
KY_DATA_PATH=./data
KY_BACKUP_PATH=./backups
# Must be a separately mounted destination in production.
KY_BULK_PATH=./bulk-test-repository
