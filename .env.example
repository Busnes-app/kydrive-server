# Compose interpolation only. Put credentials in mode-0600 .env.runtime.
# This release's published image; set the version you install. For production pin its
# verified digest instead: ghcr.io/busnes-app/kydrive-server@sha256:<digest> (README).
# docker-compose.build.yml replaces it with the local source build kydrive-server:local.
KY_IMAGE=ghcr.io/busnes-app/kydrive-server:0.4.2
KY_UID=1000
KY_GID=1000
KY_BIND_IP=127.0.0.1
KY_HTTP_PORT=8080
KY_DATA_PATH=./data
KY_BACKUP_PATH=./backups
# Must be a separately mounted destination in production.
KY_BULK_PATH=./bulk-test-repository

# Optional docker-compose.office.yml (editor may also stay on Kubernetes).
# Absolute path to a regular mode-0600 file; same printable secret as
# KYDRIVE_EDITOR_SECRET in .env.runtime. Never put the secret itself here.
# KY_OFFICE_JWT_FILE=/private/editor-jwt
KY_OFFICE_BIND_IP=127.0.0.1
KY_OFFICE_HTTP_PORT=8082
KY_OFFICE_ALLOW_PRIVATE_IP_ADDRESS=false
